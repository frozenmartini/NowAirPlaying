// shairport-sync v5 config. Copy to ~/.config/shairport-sync.conf.
// The user unit runs it with
//   /usr/bin/shairport-sync -c %h/.config/shairport-sync.conf
//
// shairport-sync talks ONLY to speakerd, over its native D-Bus interface on
// the user's session bus. It has no MQTT client and no MPRIS interface: both
// are left out of the build (see docs/ROADMAP.md, package builds). speakerd
// is the node's only MQTT client, when MQTT is used at all.
//
// When upgrading shairport-sync, start from its own sample config: v5 renamed
// settings compared with v4.

general =
{
  name = "Now AirPlaying";       // the name iPhones show in the AirPlay picker
  output_backend = "pipewire";   // audio -> user PipeWire session -> default sink (the amp)
  service_type = "airplay2";     // never "auto": auto silently downgrades to classic AirPlay 1
                                 // when nqptp's shared memory isn't up yet at boot (the user
                                 // unit races the system nqptp unit). Explicit airplay2 makes
                                 // shairport exit instead, and Restart=on-failure retries it
                                 // once nqptp is up.
  dbus_service_bus = "session";  // org.gnome.ShairportSync on the user's session bus, where
                                 // speakerd (also a user unit) finds it. On the default,
                                 // "system", the bus refuses the name to a non-root user and
                                 // shairport only logs a warning.
};

metadata =
{
  enabled = "yes";               // feeds the D-Bus Metadata property speakerd reads
};
