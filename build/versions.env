# Pinned sources for the three packages NowAirPlaying builds. Bump a version
# only together with its sha256, and rebuild and re-test on a real node.
#
# Checksums pinned 2026-09-27. How they were checked:
#  - bluez: kernel.org signature (bluez-5.87.tar.sign) verified good, key
#    E932 D120 BC2A EC44 4E55 8F01 06CA 9F5D 1DCF 2659 (Marcel Holtmann).
#  - shairport-sync, nqptp: GitHub tag archives, byte-identical to a clone
#    at the same tag (5.2.2 = fadd43d0, 1.2.8 = c925f27c).

BLUEZ_VERSION=5.87
BLUEZ_URL=https://www.kernel.org/pub/linux/bluetooth/bluez-5.87.tar.xz
BLUEZ_SHA256=26bdcf2cebd7310c6f598850606b037ef0c515fe6608ebc54d22c50c4c32b35f

SHAIRPORT_VERSION=5.2.2
SHAIRPORT_URL=https://github.com/mikebrady/shairport-sync/archive/refs/tags/5.2.2.tar.gz
SHAIRPORT_SHA256=068041f65aeb303ae24a90350c2b011b8f282d50e7335135586ee47eab9aed51

NQPTP_VERSION=1.2.8
NQPTP_URL=https://github.com/mikebrady/nqptp/archive/refs/tags/1.2.8.tar.gz
NQPTP_SHA256=3a2882a299c21605f53bb215ce537f9cc7a1e894476f639ab28562c68fd183a9

# Debian revision for our packages: <upstream>-0nap<N>. Bump N on any
# packaging change that ships.
NAP_REVISION=1
MAINTAINER="frozenmartini <180377336+frozenmartini@users.noreply.github.com>"
