# User unit (linger on): runs in the user's PipeWire session and owns
# org.gnome.ShairportSync on the user's session bus for speakerd.
# Needs the system nqptp service for AirPlay 2 timing. A user unit cannot
# order itself after a system unit, so with service_type = "airplay2" a start
# before nqptp is up exits and Restart=on-failure retries it.

[Unit]
Description=shairport-sync AirPlay 2 receiver (NowAirPlaying)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/shairport-sync -c %h/.config/shairport-sync.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
