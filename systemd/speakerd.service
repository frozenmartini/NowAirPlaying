# User unit (linger on): sees both the system bus (BlueZ) and the user
# session (PipeWire ordering). No network-online dependency; paho retries.

[Unit]
Description=NowAirPlaying speakerd (BlueZ + AirPlay metadata -> amp screen, MQTT)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/nowairplaying
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m speakerd --config %h/.config/speakerd/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
